page 2 (
    name: Reservation Entry
    alias: RESERVATION-ENTRY
    title: 予約入力
    advanced {
        reloadOnSubmit: always
    }
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText: 予約情報を入力して登録します。予約名、電話番号、来店日時、人数は必須です。
    }

    region RESERVATION_FORM (
        name: 予約情報
        type: form
        source {
            location: localDatabase
            tableName: RESTAURANT_RESERVATIONS
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P2_RESERVATION_ID (
        type: hidden
        layout {
            sequence: 5
            region: @RESERVATION_FORM
            slot: regionBody
        }
        source {
            formRegion: @RESERVATION_FORM
            column: RESERVATION_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P2_GUEST_NAME (
        type: textField
        label {
            label: 予約名
        }
        layout {
            sequence: 10
            region: @RESERVATION_FORM
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 40
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @RESERVATION_FORM
            column: GUEST_NAME
            dataType: varchar2
        }
    )

    pageItem P2_PHONE_NUMBER (
        type: textField
        label {
            label: 電話番号
        }
        layout {
            sequence: 20
            region: @RESERVATION_FORM
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        help {
            inlineHelpText: ハイフンなしで入力できます（例：09012345678）。ハイフンを入力した場合も登録時に整形します。
        }
        source {
            formRegion: @RESERVATION_FORM
            column: PHONE_NUMBER
            dataType: varchar2
        }
    )

    validation PHONE_NUMBER_FORMAT (
        name: 電話番号形式
        execution {
            sequence: 5
        }
        validation {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                REGEXP_LIKE(:P2_PHONE_NUMBER, '^[0-9]+(-[0-9]+)*$')
                AND REGEXP_LIKE(
                    REGEXP_REPLACE(:P2_PHONE_NUMBER, '-', ''),
                    '^(0[0-9]{9}|(050|070|080|090)[0-9]{8}|0800[0-9]{7})$'
                )
                ```
        }
        error {
            errorMessage: 電話番号はハイフンなし、または数字をハイフンで区切って入力してください。10桁または一般的な11桁の番号を入力してください。
            associatedItem: @P2_PHONE_NUMBER
        }
    )

    pageItem P2_EMAIL (
        type: textField
        label {
            label: メールアドレス
        }
        layout {
            sequence: 30
            region: @RESERVATION_FORM
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 40
        }
        validation {
            maxLength: 320
        }
        source {
            formRegion: @RESERVATION_FORM
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P2_RESERVATION_AT (
        type: datePicker
        label {
            label: 来店日時
        }
        layout {
            sequence: 40
            region: @RESERVATION_FORM
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: YYYY-MM-DD HH24:MI
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @RESERVATION_FORM
            column: RESERVATION_AT
            dataType: timestamp
        }
    )

    pageItem P2_PARTY_SIZE (
        type: selectList
        label {
            label: 人数
        }
        layout {
            sequence: 50
            region: @RESERVATION_FORM
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT TO_CHAR(level), level
                  FROM dual
                CONNECT BY level <= 10
                 ORDER BY level
                ```
            displayNullValue: true
        }
        source {
            formRegion: @RESERVATION_FORM
            column: PARTY_SIZE
            dataType: number
        }
    )

    pageItem P2_SPECIAL_REQUESTS (
        type: textarea
        label {
            label: メモ
        }
        layout {
            sequence: 60
            region: @RESERVATION_FORM
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @RESERVATION_FORM
            column: SPECIAL_REQUESTS
            dataType: varchar2
        }
    )

    validation EMAIL_FORMAT (
        name: メールアドレス形式
        execution {
            sequence: 10
        }
        validation {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P2_EMAIL IS NULL OR REGEXP_LIKE(:P2_EMAIL, '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$')
                ```
        }
        error {
            errorMessage: メールアドレスの形式で入力してください。
            associatedItem: @P2_EMAIL
        }
    )

    validation PARTY_SIZE_RANGE (
        name: 人数の範囲
        execution {
            sequence: 20
        }
        validation {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P2_PARTY_SIZE IS NOT NULL AND :P2_PARTY_SIZE BETWEEN 1 AND 999
                ```
        }
        error {
            errorMessage: 人数は1から999の範囲で入力してください。
            associatedItem: @P2_PARTY_SIZE
        }
    )

    region FORM_BUTTONS (
        name: 操作
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button CANCEL_RESERVATION (
        buttonName: CANCEL_RESERVATION
        label: 一覧へ戻る
        layout {
            sequence: 10
            region: @FORM_BUTTONS
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
        }
    )

    button CREATE_RESERVATION (
        buttonName: CREATE_RESERVATION
        label: 予約を登録
        layout {
            sequence: 20
            region: @FORM_BUTTONS
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            hot: true
        }
        behavior {
            action: submitPage
            databaseAction: insert
            requiresConfirmation: false
        }
    )

    process PROCESS_RESERVATION_FORM (
        name: 予約情報の登録
        type: formAutoRowProcessing
        formRegion: @RESERVATION_FORM
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: 予約を登録しました。
        }
    )

    branch RETURN_TO_RESERVATION_LIST (
        name: 予約一覧へ戻る
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: page
            pageNumber: 1
        }
    )

    process FORMAT_PHONE_NUMBER (
        name: 電話番号の整形
        type: executeCode
        source {
            location: localDatabase
            language: plsql
            plsqlCode:
                ```plsql
                DECLARE
                    l_digits VARCHAR2(30);
                BEGIN
                    l_digits := REGEXP_REPLACE(:P2_PHONE_NUMBER, '-', '');

                    IF SUBSTR(l_digits, 1, 4) = '0800' THEN
                        :P2_PHONE_NUMBER := SUBSTR(l_digits, 1, 4) || '-' ||
                                            SUBSTR(l_digits, 5, 3) || '-' ||
                                            SUBSTR(l_digits, 8, 4);
                    ELSIF LENGTH(l_digits) = 11 THEN
                        :P2_PHONE_NUMBER := SUBSTR(l_digits, 1, 3) || '-' ||
                                            SUBSTR(l_digits, 4, 4) || '-' ||
                                            SUBSTR(l_digits, 8, 4);
                    ELSIF SUBSTR(l_digits, 1, 4) = '0120' THEN
                        :P2_PHONE_NUMBER := SUBSTR(l_digits, 1, 4) || '-' ||
                                            SUBSTR(l_digits, 5, 3) || '-' ||
                                            SUBSTR(l_digits, 8, 3);
                    ELSIF SUBSTR(l_digits, 1, 4) = '0570' THEN
                        :P2_PHONE_NUMBER := SUBSTR(l_digits, 1, 4) || '-' ||
                                            SUBSTR(l_digits, 5, 2) || '-' ||
                                            SUBSTR(l_digits, 7, 4);
                    ELSIF SUBSTR(l_digits, 1, 2) IN ('03', '06') THEN
                        :P2_PHONE_NUMBER := SUBSTR(l_digits, 1, 2) || '-' ||
                                            SUBSTR(l_digits, 3, 4) || '-' ||
                                            SUBSTR(l_digits, 7, 4);
                    ELSE
                        :P2_PHONE_NUMBER := SUBSTR(l_digits, 1, 3) || '-' ||
                                            SUBSTR(l_digits, 4, 3) || '-' ||
                                            SUBSTR(l_digits, 7, 4);
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 5
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @CREATE_RESERVATION
        }
    )
)
